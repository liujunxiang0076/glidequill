#define DS_SETFONT 0x40
#define DS_MODALFRAME 0x80
#define DS_CENTER 0x800
#define WS_POPUP 0x80000000
#define WS_CAPTION 0xc00000
#define WS_SYSMENU 0x80000
#define WS_TABSTOP 0x10000
#define WS_VSCROLL 0x200000
#define WS_BORDER 0x800000
#define CBS_DROPDOWN 2
#define SS_OWNERDRAW 13
#define SS_NOTIFY 256
#define ES_NUMBER 0x2000
#define ES_AUTOHSCROLL 0x80
#define ES_MULTILINE 4
#define ES_READONLY 0x800
#define ES_AUTOVSCROLL 0x40
#define IDOK 1
#define IDCANCEL 2

401 DIALOGEX 0,0,384,291
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GlideQuill · 手势库"
FONT 9,"Microsoft YaHei UI"
BEGIN
 GROUPBOX "手势绑定", -1, 8,5,368,102
 LTEXT "作用范围", -1,16,20,64,10
 COMBOBOX 510,80,17,280,120,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
 LTEXT "手势", -1,16,40,64,10
 COMBOBOX 511,80,37,190,140,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "录制或试画…",527,274,36,86,15
 LTEXT "动作或快捷键", -1,16,60,64,12
 COMBOBOX 512,80,57,280,130,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "设置绑定",513,80,80,60,16
 PUSHBUTTON "取消绑定",514,144,80,60,16
 PUSHBUTTON "恢复继承",515,208,80,60,16
 PUSHBUTTON "删除模板",528,274,80,86,16
 GROUPBOX "应用组", -1,8,110,368,59
 LTEXT "组名", -1,16,124,38,11
 EDITTEXT 516,54,121,100,15,ES_AUTOHSCROLL
 PUSHBUTTON "保存组",518,236,120,60,16
 PUSHBUTTON "删除组",519,300,120,60,16
 LTEXT "成员", -1,16,145,34,11
 EDITTEXT 517,54,142,306,15,ES_AUTOHSCROLL
 GROUPBOX "识别与轨迹", -1,8,172,368,39
 LTEXT "触发距离 (DIP)",-1,16,188,68,10
 EDITTEXT 520,85,184,33,15,ES_NUMBER
 LTEXT "模板容差 (%)",-1,130,188,66,10
 EDITTEXT 521,198,184,33,15,ES_NUMBER
 AUTOCHECKBOX "显示轨迹",522,252,185,82,14
 PUSHBUTTON "导入并预览…",523,9,218,79,17
 PUSHBUTTON "导出规则…",524,92,218,70,17
 PUSHBUTTON "上次保存版本…",525,166,218,80,17
 PUSHBUTTON "查看待支持项…",526,250,218,125,17
 LTEXT "",529,12,240,360,23
 DEFPUSHBUTTON "返回并保留草稿",IDOK,203,266,96,18
 PUSHBUTTON "放弃本次编辑",IDCANCEL,303,266,72,18
END

402 DIALOGEX 0,0,310,191
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "录制与试画"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "按住左键或右键，在框内一笔画完后松开。",-1,10,8,286,12
 CONTROL "",532,"Static", SS_OWNERDRAW | SS_NOTIFY | WS_BORDER,10,25,290,112
 LTEXT "模板名",-1,10,145,40,11
 EDITTEXT 530,52,141,142,16,ES_AUTOHSCROLL
 LTEXT "",533,10,165,145,22
 DEFPUSHBUTTON "使用这笔轨迹",IDOK,163,165,78,18
 PUSHBUTTON "返回",IDCANCEL,245,165,54,18
END

403 DIALOGEX 0,0,360,211
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "规则预览"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "",540,10,8,340,22
 EDITTEXT 541,10,32,340,145,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
 DEFPUSHBUTTON "确认",IDOK,222,185,60,17
 PUSHBUTTON "返回",IDCANCEL,288,185,62,17
END

404 DIALOGEX 0,0,248,172
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择迁移范围"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "点选要迁移的范围，可多选。手势模板随规则一起导入。",-1,10,9,228,20
 LISTBOX 542,10,32,228,106,0x0008 | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "查看预览",IDOK,107,146,65,17
 PUSHBUTTON "取消",IDCANCEL,178,146,60,17
END
